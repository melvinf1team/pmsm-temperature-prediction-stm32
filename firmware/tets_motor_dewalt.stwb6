    "type": "CUSTOM",
    "control": {
      "hardwareFamily": "CONTROL",
      "id": "B-G473E-ZEST1S",
      "label": "B-G473E-ZEST1S",
      "compatibility": [
        "FOC",
        "sixStep"
      ],
      "descVersion": 4,
      "description": "STM32 discovery for Zest algorithm with Motor control V2 (PCI express) and ST morpho connectivity",
      "clockFrequency": 170,
      "clockSource": "internal_osc",
      "features": [
        {
          "type": "Button",
          "name": "StartStopButton",
          "hwVariants": [
            {
              "type": "PushButton",
              "signals": {
                "BUTTON_TRIGGER": [
                  {
                    "name": "PC13",
                    "help": "",
                    "cost": 0
                  }
                ]
              },
              "buttonTriggerEdge": "Falling Edge",
              "buttonGpioConfig": "Pull up",
              "help": ""
            }
          ]
        },
        {
          "name": "VCP1",
          "type": "SerialPortCommunication",
          "hwVariants": [
            {
              "type": "Uart2WiresCommunication",
              "signals": {
                "UART_TX": [
                  {
                    "name": "PA9",
                    "help": "Close SB54 solder bridge",
                    "cost": 10
                  },
                  {
                    "name": "PG9",
                    "help": "Close SB51 solder bridge (factory default)",
                    "cost": 0
                  }
                ],
                "UART_RX": [
                  {
                    "name": "PA10",
                    "help": "",
                    "cost": 0
                  }
                ]
              },
              "help": ""
            }
          ]
        },
        {
          "name": "VCP2",
          "type": "SerialPortCommunication",
          "hwVariants": [
            {
              "type": "Uart2WiresCommunication",
              "signals": {
                "UART_TX": [
                  {
                    "name": "PD5",
                    "help": "Make sure SB58 is closed.(factory default)",
                    "cost": 0
                  }
                ],
                "UART_RX": [
                  {
                    "name": "PD6",
                    "help": "Make sure that SB49 is closed.",
                    "cost": 10
                  }
                ]
              },
              "help": ""
            }
          ]
        },
        {
          "type": "Potentiometer",
          "name": "Potentiometer",
          "hwVariants": [
            {
              "type": "Potentiometer",
              "signals": {
                "POTENTIOMETER_LEVEL": [
                  {
                    "name": "PA3",
                    "help": "Make sure SB26 is closed.(factory default)",
                    "cost": 0
                  }
                ]
              },
              "potVm": 3.3,
              "potRmax": 210000,
              "potLevelMin": 0,
              "help": ""
            }
          ]
        }
      ],
